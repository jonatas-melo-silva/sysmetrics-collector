#!/usr/bin/env bash
# Duas amostras, como "top -b -n2"; só a segunda conta. O %CPU do pid i é 10-i,
# então stubproc1 lidera. O pid 9 (stubproc7 no stub do ps) soma 0.5 ao grupo.
for _ in 1 2; do
    echo 'top - 10:00:00 up 1 day,  1 user,  load average: 0.10, 0.20, 0.30'
    echo '    PID USER      PR  NI    VIRT    RES    SHR S  %CPU  %MEM     TIME+ COMMAND'
    for i in 1 2 3 4 5 6 7; do
        echo "      ${i} root      20   0       0      0      0 S   $((10 - i)).0   1.0   0:01.00 stubproc"
    done
    echo '      9 root      20   0       0      0      0 S    0.5   1.0   0:01.00 stubproc'
done
