# Ambiente de desenvolvimento: mesmas ferramentas que a CI usa.
FROM debian:12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash bats shellcheck shfmt make git ca-certificates \
        lm-sensors procps util-linux coreutils findutils sed grep \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash"]
